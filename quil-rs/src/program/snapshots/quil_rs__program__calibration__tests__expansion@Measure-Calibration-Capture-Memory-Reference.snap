	DECLARE raw_iq REAL[2]
	NONBLOCKING CAPTURE 0 "ro_rx" boxcar_kernel(duration: 1e-6) raw_iq[0]
	NONBLOCKING CAPTURE 0 "ro_rx" boxcar_kernel(duration: 1e-6) addr[0]

NONBLOCKING CAPTURE 0 "ro_rx" boxcar_kernel(duration: 1e-6) raw_iq[0]
NONBLOCKING CAPTURE 0 "ro_rx" boxcar_kernel(duration: 1e-6) ro[0]
